# Copy this file to .env (repo root) and fill in real values.
# .env is gitignored (see .gitignore: **/.env) — never commit real credentials.

# Azure SQL — shared "3sheets" server, one database with a schema per domain
# (health / legal / purchasing / retail). Scripts under datasets/*/scripts or
# datasets/*/Scripts locate this file automatically via python-dotenv's
# find_dotenv(), which walks up from the script to the repo root.
AZURE_SQL_SERVER=3sheets.database.windows.net
AZURE_SQL_DATABASE=3sheets.db.sql
AZURE_SQL_USER=azureuser
AZURE_SQL_PASSWORD=
