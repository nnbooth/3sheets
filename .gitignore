# Node dependencies
**/node_modules/

# Environment files
**/.env
**/.env.*.local

# OS artifacts
.DS_Store
Thumbs.db

# Python caches
**/__pycache__/
**/*.pyc

# Python virtual environments
.venv/
venv/

# Logs
**/*.log

# VS Code workspace cache
.vscode/
.vscode/*

# Claude Code MCP server config — local agent tooling, not portfolio content
.mcp.json

#Exclude Excel and CSV files
*.csv
*.xlsx
*.xls

# Private / personal files
businessplan.md
git_readme.md

# Owner documents — personal/private docs, not part of the portfolio repo
Owner documents/

# scripts/ folder — only .js and .py files are tracked; all docs are internal
scripts/*.md
scripts/*.sh
scripts/*.bat

# Power BI — exclude entire folder (IDE projects not suitable for version control)
Power BI/
