# Node dependencies
**/node_modules/

# Environment files
**/.env
**/.env.*.local

# OS artifacts
.DS_Store
Thumbs.db

# Python caches
**/__pycache__/
**/*.pyc

# Python virtual environments
.venv/
venv/

# Logs
**/*.log

# VS Code workspace cache
.vscode/
.vscode/*

# Claude Code MCP server config — local agent tooling, not portfolio content
.mcp.json

# Data never goes in git: it lives in OneDrive
# (~/Library/CloudStorage/OneDrive-Personal/Projects/The 4th Sheet/Data,
#  or wherever FOURTH_SHEET_DATA points). Excel, CSV and Word files excluded.
*.csv
*.xlsx
*.xls
*.docx
# ...except the Excel downloads the website serves (generated by tools/sample_data.py)
!media/exports/*.xlsx

# Private / personal files
businessplan.md
git_readme.md

# Owner documents — personal/private docs, not part of the portfolio repo
Owner documents/

# scripts/ folder — only .js and .py files are tracked; all docs are internal
scripts/*.md
scripts/*.sh
scripts/*.bat

# Power BI — exclude entire folder (IDE projects not suitable for version control)
Power BI/
