# The Fourth Sheet: website and tooling.
# Code and docs live in git. DATA DOES NOT: every dataset lives in OneDrive
# (Projects/The 4th Sheet/Data, found automatically on Mac or Windows, or set
# FOURTH_SHEET_DATA). See README.md.

# Data and office files
*.csv
*.xlsx
*.xls
*.docx
*.pbix
# ...except the Excel downloads the website serves (generated by tools/sample_data.py)
!media/exports/*.xlsx

# Secrets: copy .env.example to .env and fill it in; never commit .env
**/.env
**/.env.*.local

# Local tooling, logs and caches
.runlogs/
**/*.log
**/__pycache__/
**/*.pyc
.venv/
venv/
**/node_modules/
.vscode/
.mcp.json
.claude/

# OS clutter
.DS_Store
Thumbs.db

# LinkedIn cuts of the game video (tools/record_demo.py): not used by the site; kept in OneDrive "Media"
media/game/month-end-run-15s.*
